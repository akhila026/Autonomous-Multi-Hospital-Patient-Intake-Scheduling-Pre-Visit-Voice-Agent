# ==============================================================================
# AEGISCARE HEALTHCARE AI PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000

# Application Timezone
APPLICATION_TIMEZONE=UTC

# Database Configuration (SQLite default; for persistent disk on Render use: sqlite:////var/data/healthcare.db)
DATABASE_URL=sqlite:///./healthcare.db

# Security & Authentication Secrets (Generate secure random string in production)
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated list of permitted origins or * for open access)
ALLOWED_ORIGINS=*

# AI Provider Configuration (Optional: fallback clinical triage engine active if unset)
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Slot & Scheduling Configuration
SLOT_HOLD_DURATION_MINUTES=5

# Mock EHR Integration (Leave empty for fast in-process ASGI engine, or provide standalone URL)
MOCK_EHR_BASE_URL=
MOCK_EHR_TIMEOUT_SEC=3.0
